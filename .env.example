# Resend — transactional email (https://resend.com)
# Domain vanhero.online is verified, so the sender must be on that domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
QUOTE_FROM_EMAIL=Van Hero Quotes <quotes@vanhero.online>

# Where new quote/enquiry leads are sent
QUOTE_TO_EMAIL=Vmtofficials@gmail.com

# Optional: real driving distances (falls back to a straight-line estimate)
ORS_API_KEY=

# Driver applications send from Careers (any address on the verified domain)
APPLY_FROM_EMAIL=Van Hero Careers <careers@vanhero.online>
