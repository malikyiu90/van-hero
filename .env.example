# ---- Van Hero quote form environment variables ----
# Copy to .env.local for local dev, and add these in Vercel → Settings → Environment Variables.

# Resend (email delivery). Get a key at https://resend.com
# Until this is set, quotes still calculate but no email is sent.
RESEND_API_KEY=

# Where quote leads are emailed (defaults to Vmtofficials@gmail.com if unset)
QUOTE_TO_EMAIL=Vmtofficials@gmail.com

# The "from" address. Use onboarding@resend.dev for testing (only sends to your own
# Resend account email). After you verify vanhero.online in Resend, use e.g.:
# QUOTE_FROM_EMAIL=Van Hero Quotes <quotes@vanhero.online>
QUOTE_FROM_EMAIL=Van Hero Quotes <onboarding@resend.dev>

# OPTIONAL: OpenRouteService key for exact driving miles (free, no card) — https://openrouteservice.org
# If unset, distance is estimated from postcode coordinates (straight line × 1.3).
ORS_API_KEY=
